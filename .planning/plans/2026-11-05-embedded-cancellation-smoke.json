    "shipped_product_route": false,
    "host_fixture_source": "\"\"\"Disposable authenticated embedding host; no execution functions are patched.\"\"\"\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\nfrom fastapi import Request\nfrom fastapi.responses import StreamingResponse\nfrom jvspatial.api import endpoint, get_auth_service\nfrom jvspatial.api.exceptions import AuthenticationError\n\nfrom jvagent.action.response.streaming import format_sse_chunk\nfrom jvagent.embed import interact_stream\n\nscope = json.loads(Path('/private/tmp/jvagent-native-host-context-smoke/host-scope.json').read_text())\n\n@endpoint('/qualification/embed', methods=['POST'], auth=True, roles=['admin'])\nasync def embedding_host(request: Request) -> Any:\n    bearer = (request.headers.get('authorization') or '').removeprefix('Bearer ')\n    principal = await get_auth_service().validate_token(bearer)\n    if principal is None:\n        raise AuthenticationError(message='Host login is required')\n    body = await request.json()\n\n    async def frames():\n        async for frame in interact_stream(\n            agent_id=scope['agent_id'], user_id=principal.id,\n            session_id=body.get('session_id'), utterance=body.get('utterance',''),\n            data={'qualification_host':'native-embed'},\n            is_disconnected=request.is_disconnected,\n        ):\n            yield format_sse_chunk(frame)\n\n    return StreamingResponse(frames(), media_type='text/event-stream')\n"
  },
